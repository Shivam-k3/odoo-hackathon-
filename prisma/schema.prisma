datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  role            String           @default("EMPLOYEE") // EMPLOYEE, ADMIN_HR
  status          String           @default("ACTIVE") // ACTIVE, INACTIVE, PENDING
  employee        Employee?
  leaveDecisions  LeaveRequest[]   @relation("LeaveDecidedBy")
  notifications   Notification[]
  salaryAudits    SalaryAudit[]    @relation("SalaryAuditActor")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("users")
}

model Employee {
  id             String           @id @default(uuid())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginId        String           @unique
  firstName      String
  lastName       String
  email          String           @unique
  phone          String?
  profilePicture String?
  department     String?
  designation    String?
  joiningDate    DateTime         @default(now())
  address        String?
  dob            DateTime?
  gender         String?
  about          String?
  skills         String?          // JSON array of strings
  certifications String?          // JSON array of strings
  salary         Float?
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  allocations    LeaveAllocation[]
  salaryStructures SalaryStructure[]
  payslips       Payslip[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("employees")
}

model Attendance {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         String    // Format: YYYY-MM-DD
  checkInTime  DateTime?
  checkOutTime DateTime?
  workHours    Float     @default(0.0)
  extraHours   Float     @default(0.0)
  status       String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY, LEAVE
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@map("attendances")
}

// ================= Member 2 modules =================

model LeaveRequest {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     String // PTO, SICK, UNPAID
  startDate     DateTime  @db.Date
  endDate       DateTime  @db.Date
  requestedDays Float // calculated server-side, inclusive of start and end date
  remarks       String?
  attachment    String? // medical certificate / supporting document URL (mandatory for SICK)
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  adminComment  String?
  decidedById   String?
  decidedBy     User?     @relation("LeaveDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([employeeId, status])
  @@index([status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

model LeaveAllocation {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year       Int
  leaveType  String // PTO, SICK, UNPAID
  entitled   Float? // null = unlimited (UNPAID)
  used       Float    @default(0)

  @@unique([employeeId, year, leaveType])
  @@index([employeeId, year])
  @@map("leave_allocations")
}

model SalaryStructure {
  id            String       @id @default(uuid())
  employeeId    String       @unique
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  monthlyWage   Float
  effectiveFrom DateTime     @db.Date
  createdById   String?
  updatedById   String?
  audits        SalaryAudit[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("salary_structures")
}

model SalaryAudit {
  id              String          @id @default(uuid())
  structureId     String
  structure       SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  actorId         String?
  actor           User?           @relation("SalaryAuditActor", fields: [actorId], references: [id])
  action          String // CREATE, UPDATE
  oldWage         Float?
  newWage         Float
  createdAt       DateTime        @default(now())

  @@index([structureId])
  @@map("salary_audits")
}

model Payslip {
  id                String   @id @default(uuid())
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodYear        Int
  periodMonth       Int
  workingDays       Float
  presentDays       Float
  paidLeaveDays     Float
  unpaidLeaveDays   Float
  payableDays       Float
  monthlyWage       Float
  basicSalary       Float
  hra               Float
  standardAllowance Float
  performanceBonus  Float
  lta               Float
  fixedAllowance    Float
  grossEarnings     Float
  employeePf        Float
  employerPf        Float
  professionalTax   Float
  netPay            Float
  generatedById     String?
  generatedAt       DateTime @default(now())

  @@unique([employeeId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
  @@map("payslips")
}

model Notification {
  id              String   @id @default(uuid())
  recipientUserId String
  recipientUser   User     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  type            String // LEAVE_SUBMITTED, LEAVE_APPROVED, LEAVE_REJECTED, PAYSLIP_AVAILABLE
  title           String
  body            String?
  meta            String?  // JSON string with related entity ids
  readAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([recipientUserId, createdAt])
  @@map("notifications")
}
