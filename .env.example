PORT=5000
NODE_ENV=development
# Local development (npm run db:up starts an embedded PostgreSQL instance)
DATABASE_URL="postgresql://dayflow:dayflow@localhost:5432/dayflow_hrms"
JWT_SECRET="change_me_in_production"
JWT_EXPIRES_IN="7d"
COMPANY_NAME="Odoo India"
STANDARD_WORK_HOURS_PER_DAY=8

# Team cloud option: Supabase PostgreSQL (Project Settings -> Database -> Connection string)
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
MAX_UPLOAD_SIZE_MB=5
